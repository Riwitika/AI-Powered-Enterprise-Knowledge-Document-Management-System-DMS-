# ==============================================================================
# FAST TRADE KMS FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' or '.env.local' and customize variables.
# NEVER commit your '.env' file containing real secrets to Git.

# Backend API V1 URL proxy path or server route
# Default is '/api/v1' relative path (routed through Vite dev server proxy)
# For production: configure full backend URL (e.g. 'https://api.efasttrade.com/api/v1')
VITE_API_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8000/api/v1

# Feature flags / development settings
VITE_DEV_BYPASS_AUTO_LOGIN=false

# ==============================================================================
# FAST TRADE KMS BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your own sensitive configurations.
# NEVER commit the actual '.env' file to your Git repository.

# Environment mode ('development' or 'production')
ENV=development
DEBUG=true

# Database Connection String
# For local SQLite development: sqlite:///./kms.db
# For production PostgreSQL: postgresql://username:password@hostname:port/dbname
DATABASE_URL=sqlite:///./kms.db

# JWT Access & Refresh Token Secret Management
# Use a cryptographically strong, unique secret key for JWT signatures.
# You can generate a strong key in Python: import secrets; print(secrets.token_hex(32))
SECRET_KEY=PLACEHOLDER_SECRET_KEY_CHANGE_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI LLM Provider Configuration
# Required in production mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Additional settings (Production quality defaults)
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# CORS Allowed Origins (Comma-separated list of frontends)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
